# App URL for Stripe redirect URLs (set on Vercel Production to your prod domain, no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Beta Maroc — free calculator, feedback links (see docs/BETA_LAUNCH.md)
NEXT_PUBLIC_BETA_MODE=1
# NEXT_PUBLIC_BETA_WHATSAPP=212612345678
# NEXT_PUBLIC_BETA_FEEDBACK_URL=https://docs.google.com/forms/d/e/.../viewform

# Gumroad (recommended before LTD) — product share URLs from gumroad.com
NEXT_PUBLIC_GUMROAD_LIFETIME_URL=https://YOURNAME.gumroad.com/l/gramwise-lifetime
# NEXT_PUBLIC_GUMROAD_MONTHLY_URL=https://YOURNAME.gumroad.com/l/gramwise-monthly

# Stripe — optional later (https://dashboard.stripe.com/test/apikeys)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_LIFETIME=price_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_ALLOW_LIVE=1

# Optional: indicative FX for multi-currency display (amounts entered in MAD)
# NEXT_PUBLIC_MAD_PER_EUR=10.85
# NEXT_PUBLIC_MAD_PER_USD=10.00
